{
  "name": "live-quiz-game",
  "version": "1.0.0",
  "description": "LIVE QUIZ GAME — منصة مسابقات تفاعلية مباشرة لـ TikTok LIVE، تُدار من الهاتف",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit -p web && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "validate": "node --disable-warning=ExperimentalWarning scripts/validate-bank.js",
    "build:mobile": "node scripts/build-mobile.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.13.0",
    "tiktok-live-connector": "^2.5.0",
    "tiktok-live-connector-legacy": "npm:tiktok-live-connector@^1.2.3"
  },
  "devDependencies": {
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.21.5",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
