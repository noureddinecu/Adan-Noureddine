# City for the prayer times on the TV (Aladhan method 3 = Muslim World League, used in Europe).
LAT=40.4168
LON=-3.7038
METHOD=3
CITY="مدريد"
# Adhan: searched on YouTube by the build; leave empty for a silent banner.
ADHAN_QUERY="أذان أنس التازي"
# The one the owner named: «آذان رائع بالصيغة المغربية للقارئ أنس التازي» (2:41). Wins over the search.
ADHAN_URL="https://www.youtube.com/watch?v=yzZwAt1DRKA"
