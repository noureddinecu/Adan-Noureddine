# Copy to .env (or set in your host's dashboard)
PORT=3000
HOST=0.0.0.0
# Dashboard password. If empty, a one-time setup code is printed in the server log to create one.
ADMIN_PASSWORD=
# Optional Euler Stream API key used by tiktok-live-connector (higher rate limits)
TIKTOK_SIGN_API_KEY=
# Where the SQLite database and uploads are stored
DATA_DIR=./storage
# Changing sports facts older than this are excluded from play until re-verified
VOLATILE_MAX_AGE_DAYS=180
# Set to 1 behind a reverse proxy (Render/Railway/Fly set it automatically)
TRUST_PROXY=0
